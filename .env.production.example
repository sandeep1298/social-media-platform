# Backend runtime values
MONGODB_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>/<database>?retryWrites=true&w=majority
# Redis Cloud: use redis:// without TLS, or rediss:// when TLS is enabled.
# URL-encode any reserved characters in the password, such as @, :, /, or #.
REDIS_URL=redis://default:<url-encoded-password>@<host>:<port>
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=7d
CORS_ORIGIN=http://localhost:8080
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120

# Frontend build values (these are intentionally public Vite variables)
VITE_API_URL=http://localhost:5000/api
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
