NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>/<database>?retryWrites=true&w=majority
# Use rediss:// instead when TLS is enabled in Redis Cloud.
REDIS_URL=redis://default:<url-encoded-password>@<host>:<port>
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=7d
CORS_ORIGIN=https://your-frontend-domain.example
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
